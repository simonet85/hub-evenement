# Modèle d'environnement de production — aucun secret réel.
# Copiez ce fichier en `.env` sur le serveur, puis renseignez les valeurs.

APP_NAME="Hub Événement"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://votre-domaine.example
APP_TIMEZONE=Africa/Abidjan

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hub_evenement
DB_USERNAME=hub
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.votre-fournisseur.example
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="bonjour@votre-domaine.example"
MAIL_FROM_NAME="${APP_NAME}"

MONEYFUSION_DRIVER=http
MONEYFUSION_API_URL=https://api.moneyfusion.net/api/create-payment
MONEYFUSION_APP_KEY=
MONEYFUSION_CHECK_PAYMENT_URL=https://pay.moneyfusion.net/paiementNotif
MONEYFUSION_ROUTES_ENABLED=false

# Reverse proxy / CDN devant l'application, séparés par des virgules.
TRUSTED_PROXIES=

# Anonymisation des données invités après l'événement (en jours).
GUEST_DATA_RETENTION_DAYS=90

VITE_APP_NAME="${APP_NAME}"
